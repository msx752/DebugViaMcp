  <Commands package="guidDebugViaMcpPackage">
    <Menus>
      <Menu guid="guidDebugViaMcpCmdSet" id="DebugViaMcpMenu" priority="0x0700" type="Menu">
        <Parent guid="guidDebugViaMcpCmdSet" id="ExtensionsMenuGroup" />
        <Strings>
          <ButtonText>Debugging via MCP</ButtonText>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidDebugViaMcpCmdSet" id="ExtensionsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
      </Group>
      <Group guid="guidDebugViaMcpCmdSet" id="SetupGroup" priority="0x0050">
        <Parent guid="guidDebugViaMcpCmdSet" id="DebugViaMcpMenu" />
      </Group>
      <Group guid="guidDebugViaMcpCmdSet" id="AccessGroup" priority="0x0100">
        <Parent guid="guidDebugViaMcpCmdSet" id="DebugViaMcpMenu" />
      </Group>
      <Group guid="guidDebugViaMcpCmdSet" id="ViewGroup" priority="0x0200">
        <Parent guid="guidDebugViaMcpCmdSet" id="DebugViaMcpMenu" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidDebugViaMcpCmdSet" id="SetupAgent" priority="0x0090" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="SetupGroup" />
        <Strings>
          <ButtonText>Set Up AI Agent…</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDebugViaMcpCmdSet" id="DisconnectAi" priority="0x0100" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="AccessGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Disconnect AI</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDebugViaMcpCmdSet" id="ReconnectAi" priority="0x0101" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="AccessGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Reconnect AI</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDebugViaMcpCmdSet" id="ShowActivity" priority="0x0100" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="ViewGroup" />
        <Strings>
          <ButtonText>Show Activity</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDebugViaMcpCmdSet" id="OpenLogsFolder" priority="0x0101" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="ViewGroup" />
        <Strings>
          <ButtonText>Open Logs Folder</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDebugViaMcpCmdSet" id="OpenOptions" priority="0x0102" type="Button">
        <Parent guid="guidDebugViaMcpCmdSet" id="ViewGroup" />
        <Strings>
          <ButtonText>Options…</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>
  <KeyBindings>
    <KeyBinding guid="guidDebugViaMcpCmdSet" id="DisconnectAi" editor="guidVSStd97" key1="VK_F12" mod1="Control Alt Shift" />
  </KeyBindings>
