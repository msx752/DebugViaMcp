<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DebugViaMcp.Mcp</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>MCP server (carried inside the Debugging via MCP extension) that lets AI agents such as Claude Code drive the Visual Studio debugger. Needs the Debugging via MCP extension in Visual Studio 2022 (17.14+) or 2026.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DebugViaMcp.Protocol\DebugViaMcp.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DebugViaMcp.Mcp.Tests" />
  </ItemGroup>
</Project>
