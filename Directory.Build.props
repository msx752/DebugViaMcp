<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- One version for the extension and the tool; keep in sync with source.extension.vsixmanifest Identity/@Version. -->
    <!-- First public release is a preview: the tool is a NuGet prerelease (0.4.0-preview.1); the VSIX carries <Preview>true</Preview>. Drop VersionSuffix for the stable release. -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>VsMcpDebugger contributors</Authors>
    <Copyright>Copyright (c) VsMcpDebugger contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
